# Server-side only. Never exposed to the browser.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional: point to a compatible endpoint (e.g. Azure / proxy)
OPENAI_BASE_URL=https://api.openai.com/v1
